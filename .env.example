# Timezone inside containers
TZ=Europe/Berlin

# Web port exposed on the host (default: http://localhost:81)
AOWOW_PORT=81

# External Docker network name of your running AzerothCore stack
# Find yours via: docker network ls
AC_DOCKER_NETWORK=wow-server-playerbots_ac-network

# Path to your WoW 3.3.5a client "Data" folder on the host (used by mpq-extractor)
# Example (WSL2): /mnt/d/Games/World of Warcraft 3.3.5a/Data
# Example (Linux): /opt/wow-3.3.5a/Data
WOW_DATA_DIR=/path/to/WoW_3.3.5a/Data
